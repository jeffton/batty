    "@fastify/static": "9.1.3",
    "@fontsource/source-sans-3": "5.2.9",
    "@lucide/vue": "1.18.0",
    "@mozilla/readability": "0.6.0",
    "@oddbird/css-anchor-positioning": "0.9.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.1",
    "croner": "10.0.1",
    "dompurify": "3.4.10",
    "fastify": "5.8.5",
    "highlight.js": "11.11.1",
    "idb-keyval": "6.2.5",
    "jsdom": "29.1.1",
    "marked": "18.0.5",
