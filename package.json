{
  "name": "batty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:client": "vp dev",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "vp build && vp pack",
    "build:client": "vp build",
    "build:server": "vp pack",
    "start": "./scripts/start.sh",
    "deploy:macos": "./scripts/deploy-macos.sh",
    "deploy:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-windows.ps1",
    "add-user": "tsx src/server/add-user.ts",
    "batty": "tsx src/server/cli.ts",
    "test": "vp test --run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "vp check && pnpm typecheck",
    "check:fix": "vp check --fix"
  },
