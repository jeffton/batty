[Unit]
Description=Batty web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/batty/current
Environment=BATTY_HOST=127.0.0.1
Environment=BATTY_PORT=3147
Environment=BATTY_SELF_PATH=/opt/batty/current
ExecStart=/usr/bin/env node /opt/batty/current/dist/server/main.mjs /root/github
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
