    "pinia-plugin-persistedstate": "4.7.1",
    "playwright": "1.60.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typebox": "1.2.10",
    "virtua": "0.49.1",
    "vue": "3.5.38",
    "vue-router": "5.1.0",
    "web-push": "3.6.7",
